# Copy to .env and fill in. Both values are on the Supabase dashboard: Project Settings > API.
# Project URL only, without /rest/v1/ on the end
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Contact shown to Open Food Facts in the User-Agent, as they ask (an email address). Optional.
EXPO_PUBLIC_OFF_CONTACT=
